{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/chezmoi/key.txt)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "hyperframes-animation": "name-only",
    "hyperframes-audio": "name-only",
    "hyperframes-cli": "name-only",
    "hyperframes-core": "name-only",
    "hyperframes-creative": "name-only",
    "hyperframes-keyframes": "name-only",
    "hyperframes-registry": "name-only",
    "hyperframes-studio": "name-only",
    "media-use": "name-only",
    "embedded-captions": "name-only",
    "faceless-explainer": "name-only",
    "figma": "name-only",
    "general-video": "name-only",
    "motion-graphics": "name-only",
    "music-to-video": "name-only",
    "pr-to-video": "name-only",
    "product-launch-video": "name-only",
    "remotion-to-hyperframes": "name-only",
    "slideshow": "name-only",
    "talking-head-recut": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ste-writing/hooks/ste-inject.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/journal-offer.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ste-writing/hooks/ste-inject.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ste-writing/hooks/ste-gate.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-no-verify.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/cap-bash-output.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-lint-config.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/journal-write.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "watermarks-remover@watermarks-remover": true,
    "impeccable@impeccable": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "watermarks-remover": {
      "source": {
        "source": "github",
        "repo": "guillaumemeyer/watermarks-remover"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "auto",
  "agentPushNotifEnabled": true
}
