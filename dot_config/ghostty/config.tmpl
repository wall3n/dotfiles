# ══════════════════════════════════════════════════════════════════
#  Ghostty — managed by chezmoi
# ══════════════════════════════════════════════════════════════════

# ─── Appearance ───────────────────────────────────────────────────
theme = Gruvbox Dark Hard
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-thicken = true

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
# Keep the native frame: rounded corners, traffic lights and, most
# importantly, native fullscreen. `false` makes a borderless window
# that macOS refuses to fullscreen.
window-decoration = true

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# Slight transparency, but keep text crisp
background-opacity = 0.96
background-blur-radius = 20

# ─── Behaviour ────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title
scrollback-limit = 10000
copy-on-select = clipboard
confirm-close-surface = false
window-save-state = always

{{ if eq .chezmoi.os "darwin" -}}
# ─── macOS ────────────────────────────────────────────────────────
# Left Option is Alt, so tmux/nvim receive Alt-<key> (the floax
# binding Alt+p and every other Meta chord). Right Option still types
# the Spanish ISO symbols: @ # [ ] { } | \
macos-option-as-alt = left
# `hidden` removes the titlebar, so the window has no drag area and no
# green button. `transparent` keeps the chrome but lets the terminal
# background come through.
macos-titlebar-style = transparent
macos-window-buttons = visible

# Use the real macOS fullscreen (Cmd+Enter or Cmd+Ctrl+F).
macos-non-native-fullscreen = false
{{ end -}}

# ─── Keybindings ──────────────────────────────────────────────────
# tmux owns splits and tabs, so Ghostty only keeps the essentials.
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size
