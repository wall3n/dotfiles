#!/bin/bash

# --- macOS (Homebrew) ---
{{ if eq .chezmoi.os "darwin" -}}
echo "🍎 Detectado macOS. Verificando Homebrew..."

if ! command -v brew &> /dev/null; then
    echo "Instalando Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
if [[ -f /opt/homebrew/bin/brew ]]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
if [[ -f /usr/local/bin/brew ]]; then eval "$(/usr/local/bin/brew shellenv)"; fi

# El script se vuelve a ejecutar cuando cambia el Brewfile.
# Brewfile sha256: {{ include "Brewfile" | sha256sum }}
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"

# Se instalan solo si faltan: en este Mac ya existen fuera de Homebrew,
# y un cask sobre una app existente hace fallar `brew bundle`.
command -v starship &> /dev/null || brew install starship
[[ -d /Applications/Ghostty.app ]] || brew install --cask ghostty
ls ~/Library/Fonts/JetBrainsMonoNerdFont* &> /dev/null \
    || brew install --cask font-jetbrains-mono-nerd-font

# Key repeat rápido (mejor para navegación vim). Requiere reiniciar sesión.
defaults write -g KeyRepeat -int 1
defaults write -g InitialKeyRepeat -int 15

# --- Linux (Debian/Ubuntu) ---
{{ else if eq .chezmoi.os "linux" -}}
echo "🐧 Detectado Linux. Instalando dependencias..."

sudo apt update
sudo apt install -y zsh git build-essential curl wget gpg fd-find fzf tmux
sudo snap install nvim --classic

# Instalar Starship
if ! command -v starship &> /dev/null; then
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# Instalar Zoxide
if ! command -v zoxide &> /dev/null; then
    curl -sS https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
fi

# Instalar mise
if ! command -v mise &> /dev/null && [ ! -x "$HOME/.local/bin/mise" ]; then
    curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"

# Instalar Bat
sudo apt install -y bat
mkdir -p ~/.local/bin
ln -sf /usr/bin/batcat ~/.local/bin/bat

# Instalar EZA (Reemplazo de LSD) - Método oficial repositorio gierens
if ! command -v eza &> /dev/null; then
    echo "Instalando Eza..."
    sudo mkdir -p /etc/apt/keyrings
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
    sudo apt update
    sudo apt install -y eza
fi

# En macOS lo instala el Brewfile
if [ ! -d "$HOME/.zsh/zsh-autosuggestions" ]; then
    echo "Instalando zsh-autosuggestions..."
    git clone https://github.com/zsh-users/zsh-autosuggestions ~/.zsh/zsh-autosuggestions
fi

{{ end -}}

# --- Ejecución común ---

# Runtimes de ~/.config/mise/config.toml (java, node, python, uv...)
if command -v mise &> /dev/null; then
    echo "📦 Instalando runtimes con mise..."
    mise install
fi

if ! command -v opencode &> /dev/null; then
    echo "🤖 Instalando Opencode Agent CLI..."
    curl -fsSL https://opencode.ai/install | bash
fi

if [ "$(basename "$SHELL")" != "zsh" ]; then
    echo "Cambiando shell a Zsh..."
    chsh -s "$(command -v zsh)"
fi

# --- Bootstrap de herramientas Neovim vía Mason (idempotente) ---
if command -v nvim &> /dev/null; then
    echo "🔧 Instalando LSP/DAP/formatters vía Mason..."
    nvim --headless "+MasonInstall jdtls java-debug-adapter java-test prettier google-java-format stylua" +qall 2>/dev/null || true
fi

echo "✅ Instalación completada."
