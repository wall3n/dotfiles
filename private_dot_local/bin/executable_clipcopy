#!/usr/bin/env bash
# Copy stdin to the macOS clipboard (pbcopy, or the tmux buffer as fallback).
set -euo pipefail

if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
elif command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
    exec tmux load-buffer -
else
    echo "clipcopy: no clipboard backend found" >&2
    exit 1
fi
