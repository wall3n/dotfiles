#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════
#  tmux-sessionizer — ThePrimeagen style
#  Fuzzy-find un directorio y crea/cambia a su sesión tmux.
#
#  Uso:
#    tmux-sessionizer              → fzf interactivo
#    tmux-sessionizer /ruta/dir    → directo sin fzf
#
#  Atajos: Ctrl-f en zsh (fuera de tmux) · <prefix> f dentro de tmux
#
#  Configuración opcional (se carga si existe):
#    ~/.config/tmux-sessionizer/tmux-sessionizer.conf
#      TS_SEARCH_PATHS=(~/01-projects:2 ~/otra/ruta:1)   # ruta:profundidad
#
#  Hidratación: si el proyecto tiene un fichero `.tmux-sessionizer`
#  (o existe ~/.tmux-sessionizer), se ejecuta al crear la sesión.
#  Ejemplo: `tmux new-window -n server; tmux send-keys 'nvim .' C-m`
# ══════════════════════════════════════════════════════════════════

# ─── Directorios donde buscar proyectos (ruta:profundidad) ────────
TS_SEARCH_PATHS=(
    "$HOME/01-projects:2"
    "$HOME/02-areas:2"
    "$HOME/hackathon-kit:1"
    "$HOME/.config:1"
)
# Rutas que se ofrecen tal cual, sin buscar dentro
TS_EXTRA_PATHS=(
    "$HOME/.local/share/chezmoi"
)

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer/tmux-sessionizer.conf"
# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

# ─── Funciones ────────────────────────────────────────────────────

# Sesiones abiertas primero (marcadas con *), después los directorios
list_candidates() {
    tmux list-sessions -F '* #{session_name}' 2>/dev/null
    local entry dir depth
    for entry in "${TS_SEARCH_PATHS[@]}"; do
        dir="${entry%%:*}"
        depth="${entry##*:}"
        [[ "$depth" == "$entry" ]] && depth=1
        [[ -d "$dir" ]] || continue
        find "$dir" -mindepth 1 -maxdepth "$depth" -type d \
            -not -path '*/.git' -not -path '*/.git/*' \
            -not -path '*/node_modules*' 2>/dev/null
    done
    for dir in "${TS_EXTRA_PATHS[@]}"; do
        [[ -d "$dir" ]] && echo "$dir"
    done
}

switch_to() {
    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$1"
    else
        tmux switch-client -t "$1"
    fi
}

hydrate() {
    local session=$1 dir=$2
    if [[ -f "$dir/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$session" "source '$dir/.tmux-sessionizer'" C-m
    elif [[ -f "$HOME/.tmux-sessionizer" ]]; then
        tmux send-keys -t "$session" "source '$HOME/.tmux-sessionizer'" C-m
    fi
}

# ─── Lógica principal ─────────────────────────────────────────────

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        list_candidates | awk '!seen[$0]++' | sed "s|^$HOME|~|" \
        | fzf \
            --prompt="  Sesión: " \
            --height=50% \
            --reverse \
            --border=rounded \
            --preview 'p={}; [[ $p == "* "* ]] && tmux capture-pane -ept "${p#\* }" 2>/dev/null || eza -1 --icons --group-directories-first "${p/#\~/$HOME}" 2>/dev/null || ls -1 "${p/#\~/$HOME}"' \
            --preview-window=right:45%
    )
fi

# Si el usuario cancela fzf, salir limpiamente
[[ -z $selected ]] && exit 0

# Sesión ya abierta → saltar a ella
if [[ $selected == "* "* ]]; then
    switch_to "${selected#\* }"
    exit 0
fi

selected="${selected/#\~/$HOME}"
# Normalizar el nombre de sesión: tmux no admite puntos ni dos puntos
selected_name=$(basename "$selected" | tr '.:' '__')

# Crear la sesión en background si no existe, e hidratarla
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
    hydrate "$selected_name" "$selected"
fi

switch_to "$selected_name"
